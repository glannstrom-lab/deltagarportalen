# Pre-push-gate (K1, 2026-08-05).
#
# Varför den finns: 2026-08-05 gick en push till main som fällde deployen på
# `vercel build` efter 35 sekunder. Alla sju lokala grindar var gröna — de
# kontrollerade bara aldrig den fil som ändrats (client/vercel.json). Samma
# klass som lärdomen 2026-08-04: "kör det kommando CI kör, inte det som
# liknar det."
#
# Designen är medvetet tvådelad, så att grinden är snabb i normalfallet:
#   ALLTID   — sekundsnabba kontroller som fångar de fel som faktiskt nått prod
#   VILLKORAT— fullt bygge, men bara när bygg-/deploy-påverkande filer ändrats
#
# `npm run test:coverage` ingår INTE. Skälet ovan ("röd sedan tidigare, ROADMAP D13") är dött
# sedan 2026-08-09 — coverage passerar lokalt på alla fyra mått. Mätt 2026-08-12: test:coverage
# tar 42s och går grönt (99 filer, 1395 tester). `typecheck:ceiling` ingår heller INTE — mätt
# samma dag tog den 45s men FÄLLDE (470 fel mot tak 466), i ett träd med pågående parallellt
# agentarbete, så talet kan inte tas som sant för main utan en ren mätning. Se ROADMAP D23 för
# nästa steg innan någon av de två läggs in här. CLAUDE.md är rättad så den inte längre påstår
# att den här hooken kör `npm run verify` — det har den aldrig gjort.
#
# Nödutgång: git push --no-verify

set -e
cd client

echo "pre-push: snabba grindar …"
npm run --silent lint:vercel
npm run --silent lint:schema
npm run --silent typecheck:critical
npm run --silent lint:ci
npm run --silent lint:design

# Vilka filer skiljer mot det som redan ligger på origin/main?
RANGE="origin/main...HEAD"
if ! git rev-parse --verify --quiet origin/main >/dev/null; then
  RANGE="HEAD"
fi
CHANGED=$(git diff --name-only "$RANGE" 2>/dev/null || git diff --name-only HEAD)

if echo "$CHANGED" | grep -qE '^client/(vercel\.json|package\.json|package-lock\.json|vite\.config|index\.html|tsconfig|scripts/)|^\.github/workflows/'; then
  echo "pre-push: bygg-/deploy-påverkande filer ändrade — kör fullt bygge (samma kommando som Vercel)."
  npm run build
else
  echo "pre-push: inga bygg-/deploy-påverkande filer — hoppar över fullt bygge."
fi

echo "pre-push: OK"
