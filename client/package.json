{
  "name": "client",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-guides.cjs && node scripts/generate-sitemap.cjs",
    "content:refresh": "node scripts/content-snapshot.cjs",
    "content:triage": "node scripts/triage-articles.cjs",
    "content:new": "node scripts/apply-new-articles.cjs",
    "guides": "node scripts/prerender-guides.cjs && node scripts/generate-sitemap.cjs",
    "build:only": "vite build",
    "sitemap": "node scripts/generate-sitemap.cjs",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 122",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "analyze": "vite build --mode analyze",
    "build:prod": "vite build --mode production",
    "verify:widget-chunks": "node scripts/verify-widget-chunks.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:critical": "node scripts/typecheck-critical.cjs",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "typecheck:ceiling": "node scripts/typecheck-ceiling.cjs",
    "lint:design": "node scripts/check-design-debt.cjs",
    "lint:schema": "node scripts/check-schema-drift.cjs",
    "lint:vercel": "node scripts/check-vercel-config.cjs",
    "lint:links": "node scripts/lint-links.cjs",
    "verify": "npm run lint:vercel && npm run lint:schema && npm run typecheck:critical && npm run typecheck:api && npm run typecheck:ceiling && npm run lint:ci && npm run lint:design && npm run lint:links && npm run test:coverage",
    "schema:refresh": "node scripts/refresh-schema-snapshot.cjs",
    "report:i18n": "node scripts/report-hardcoded-swedish.cjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/react": "^10.45.0",
    "@sparticuz/chromium": "^148.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/blob": "^2.6.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "dompurify": "^3.3.3",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.36.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.18",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.574.0",
    "mammoth": "^1.12.1",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "puppeteer-core": "^24.43.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.6.11",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.0.7",
    "@vitest/ui": "^3.0.7",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.2.0",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-compression2": "^2.5.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^3.0.7"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint --quiet --no-warn-ignored"
  }
}
